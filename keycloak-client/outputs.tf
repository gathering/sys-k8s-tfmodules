output "client_id" {
  description = "Client ID the application logs in with"
  value       = keycloak_openid_client.this.client_id
}

output "keycloak_id" {
  description = "Keycloak's internal ID of the client, for resources that attach to it, such as more protocol mappers"
  value       = keycloak_openid_client.this.id
}

output "client_secret" {
  description = "Client secret of a `CONFIDENTIAL` client, generated by Keycloak. Null for a `PUBLIC` client"
  sensitive   = true
  value       = var.access_type == "CONFIDENTIAL" ? keycloak_openid_client.this.client_secret : null
}
